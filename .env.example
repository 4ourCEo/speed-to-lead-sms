# Database
DATABASE_URL=sqlite:///./hvac_intake.db

# SMS Provider (twilio or callrail)
SMS_PROVIDER=twilio

# Twilio (leave empty for local demo/testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# CallRail (required only if SMS_PROVIDER=callrail)
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
CALLRAIL_COMPANY_ID=

# Startup Shop Configuration (for production/ephemeral deployments)
# Set TWILIO_TRACKING_NUMBER to auto-create/update a shop at startup
SHOP_NAME=Speed-to-Lead Demo
TWILIO_TRACKING_NUMBER=
SHOP_OWNER_CELL=
BOOKING_CALENDAR_LINK=https://cal.com/demo

# Owner Notification Configuration (Interim $0 notification path)
# Set INTERIM_NO_SMS=true to disable SMS to caller and rely on owner notifications
INTERIM_NO_SMS=false
SKIP_CALLER_SMS=false
# Slack incoming webhook URL for missed call notifications
SLACK_WEBHOOK_URL=
# Email address to notify owner of missed calls (requires RESEND_API_KEY)
OWNER_NOTIFY_EMAIL=
# Resend API key for email notifications (optional, get from resend.com)
RESEND_API_KEY=
# Resend sending domain (optional, defaults to resend.dev)
RESEND_DOMAIN=resend.dev
# Phone number to display in callback CTA (optional, defaults to tracking number)
OWNER_CALLBACK_PHONE=

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
